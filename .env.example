# Copy to .env (git-ignored) or export in your shell. Never commit real keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# ANTHROPIC_API_KEY=
LLM_BACKEND=auto            # auto|openrouter|anthropic|offline
EMBEDDING_BACKEND=auto      # auto|bge|hash
VECTOR_BACKEND=numpy        # numpy|chroma
